# =========================================
# MeshLink .gitignore
# Rust + Go + Tauri + Windows
# =========================================


# =========================
# Rust
# =========================

target/
**/target/

*.rs.bk


# =========================
# Go
# =========================

*.exe
*.test
*.out

coverage.out


# =========================
# Tauri / Frontend
# =========================

node_modules/

dist/

build/

.vite/

out/


# =========================
# Windows build files
# =========================

*.exe
*.dll
*.pdb
*.msi


# =========================
# Runtime files
# =========================

runtime/

tmp/

temp/

*.pid

*.lock


# =========================
# Database
# =========================

*.db
*.db-shm
*.db-wal

*.sqlite
*.sqlite3


# =========================
# Logs
# =========================

*.log

logs/


# =========================
# Test generated files
# =========================

exchange-test/

test-output/

out-*.txt

err-*.txt


# =========================
# Local generated reports
# =========================

.cargo-check-output.txt
.doc_extract.txt
.workspace-test.txt


# =========================
# Environment
# =========================

.env
.env.*


# =========================
# IDE
# =========================

.vscode/

.idea/

*.suo
*.user


# =========================
# OS
# =========================

Thumbs.db

Desktop.ini

.DS_Store


# =========================
# AI temporary files
# =========================

.ai/

.chatgpt/

*.tmp

*.bak


# =========================
# MeshLink runtime generated
# =========================

runtime_token.json

active_session.json

quick_code.json

temporary_candidates.json


# =========================
# Local controller files
# =========================

controller.db


# =========================
# Keep source
# =========================

!docs/**/*.md

