# =========================================
# MeshLink Project .gitignore
# Rust + Go + Tauri + Windows
# =========================================


# =========================
# Rust
# =========================

# Rust build output
target/

# Cargo generated files
Cargo.lock.tmp

# Rust backup
*.rs.bk


# =========================
# Go
# =========================

# Go build output
*.exe
*.out

# Go test cache
*.test

# Go coverage
coverage.out
cover.out


# =========================
# Tauri / Frontend
# =========================

# Node dependencies
node_modules/

# Frontend build
dist/
build/
out/

# Vite cache
.vite/

# Tauri build
src-tauri/target/


# =========================
# Windows
# =========================

# Executables
*.exe

# Dynamic libraries
*.dll

# Windows debug symbols
*.pdb

# Installer output
*.msi

# Temporary Windows files
Thumbs.db
Desktop.ini


# =========================
# Runtime files
# =========================

runtime/

tmp/

temp/

*.pid

*.lock


# =========================
# Database
# =========================

# SQLite
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3


# =========================
# Logs
# =========================

*.log

logs/

*.trace


# =========================
# Test output
# =========================

test-output/

tests/output/

exchange-test/

*_output.txt

out-*.txt

err-*.txt


# =========================
# Environment
# =========================

.env

.env.*

!.env.example


# =========================
# IDE
# =========================

.vscode/

.idea/

*.suo
*.user
*.userosscache
*.sln.docstates


# =========================
# OS
# =========================

.DS_Store


# =========================
# AI temporary files
# =========================

.ai/

.chatgpt/

.temp/

*.tmp

*.bak


# =========================
# Local documents
# =========================

# Local reports
local-reports/

# Private notes
private/


# =========================
# MeshLink specific
# =========================

# Runtime identity cache
runtime_token.json
active_session.json
quick_code.json
temporary_candidates.json

# Local controller database
controller.db

# Local generated binaries
MeshLink.exe
mesh-agent.exe
controller.exe
n2n-supernode.exe


# =========================
# Keep important third_party
# =========================

# Ignore downloaded binaries only
third_party/**/bin/*.exe

